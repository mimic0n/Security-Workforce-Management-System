{
  "name": "swms-monorepo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:race": "vitest run race",
    "db:migrate": "tsx db/migrate.ts up",
    "db:migrate:down": "tsx db/migrate.ts down",
    "db:seed": "tsx db/seed/seed.ts",
    "sim": "tsx apps/api/src/sim/cli.ts",
    "sim:all": "tsx apps/api/src/sim/cli.ts --all"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.12.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "dependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "js-yaml": "^5.5.0",
    "pg-boss": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
